# DamzD Bot — FEI-XMD engine underneath, DamzD skin on top.
# Keep provider keys and real secrets out of Git.
BOT_NAME=DamzD
BOT_VERSION=2.0.1
PREFIX=.
OWNER_NAME=DamzD
OWNER_NUMBER=2348000000000
BOT_MODE=public
LOG_LEVEL=warn

# Bot menu artwork (the local assets/bot-image.png wins when present).
BOT_IMAGE=

FEI_SESSION_DIR=./auth_info_baileys
FEI_DATA_DIR=./data

# Optional non-interactive pairing number (country code + digits, no + sign).
PAIRING_NUMBER=

# Your dashboard URL (shown in .menu and the connect card). On Render this
# is your service URL, e.g. https://damzd.onrender.com — set it after deploy.
BOT_URL=
