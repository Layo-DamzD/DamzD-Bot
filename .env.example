# DamzD configuration — copy this file to .env and fill it in.

BOT_NAME=DamzD
OWNER_NAME=DamzD

# Your WhatsApp number in international format, without + or 00.
# If left empty, the number that pairs first becomes the owner automatically.
OWNER_NUMBER=2348000000000

# self = only the owner can use the bot, public = everyone
ACCESS_MODE=self
PREFIX=.
PORT=3000
LOG_LEVEL=warn

# Auto-fetch media when a TikTok/YouTube/Instagram/Facebook link is sent
AUTO_DL=true

# Optional AI keys (free tiers available). The bot still chats without them
# through a keyless fallback, but Groq makes it faster and smarter.
# Get one at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional backup AI — https://openrouter.ai
OPENROUTER_API_KEY=

# Optional: enables the .removebg command — https://photoroom.com/api
PHOTOROOM_API_KEY=
PAIRING_CODE=DAMZD777
