# ── DamzD configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Your WhatsApp number in international format, digits only (e.g. 2348012345678)
OWNER_NUMBER=234XXXXXXXXXX

# How people call you
OWNER_NAME=Boss

# "self"   → only you can talk to the bot (private personal bot)
# "public" → anyone in your chats can use it
ACCESS_MODE=self

# AI brain — only ONE key is required. Groq is free: https://console.groq.com/keys
GROQ_API_KEY=
# Optional backup brain (also free): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: change the AI model (defaults are fine)
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional tweaks
BOT_NAME=DamzD
PREFIX=.
LOG_LEVEL=warn
PORT=3000
